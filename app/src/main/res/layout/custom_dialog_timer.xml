<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:background="@drawable/dialog_bg"
	android:orientation="vertical"
	android:padding="24dp"
	android:gravity="center_horizontal">

	<TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text="Timer"
		android:textColor="#FFFFFF"
		android:textSize="20sp"
		android:textStyle="bold"
		android:layout_gravity="left"/>

	<RadioGroup
		android:id="@+id/quality_group_timer"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="16dp">

		<RadioButton
			android:id="@+id/none"
			android:layoutDirection="rtl"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingTop="12dp"
			android:paddingBottom="12dp"
			android:text="None"
			android:textColor="#E0E0E0"/>

		<View
			android:layout_width="match_parent"
			android:layout_height="1dp"
			android:background="#FF9E9E9E"/>

		<RadioButton
			android:id="@+id/currtrack"
			android:layoutDirection="rtl"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingTop="12dp"
			android:paddingBottom="12dp"
			android:text="Close after current track"
			android:textColor="#E0E0E0"/>

		<View
			android:layout_width="match_parent"
			android:layout_height="1dp"
			android:background="#FF9E9E9E"/>

		<RadioButton
			android:id="@+id/tenmin"
			android:layoutDirection="rtl"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingTop="12dp"
			android:paddingBottom="12dp"
			android:checked="true"
			android:text="After 10 min"
			android:textColor="#E0E0E0"/>

		<View
			android:layout_width="match_parent"
			android:layout_height="1dp"
			android:background="#FF9E9E9E"/>

		<RadioButton
			android:id="@+id/twenmin"
			android:layoutDirection="rtl"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingTop="12dp"
			android:paddingBottom="12dp"
			android:checked="true"
			android:text="After 20 min"
			android:textColor="#E0E0E0"/>

		<View
			android:layout_width="match_parent"
			android:layout_height="1dp"
			android:background="#FF9E9E9E"/>

		<RadioButton
			android:id="@+id/thirmin"
			android:layoutDirection="rtl"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingTop="12dp"
			android:paddingBottom="12dp"
			android:checked="true"
			android:text="After 30 min"
			android:textColor="#E0E0E0"/>

		<View
			android:layout_width="match_parent"
			android:layout_height="1dp"
			android:background="#FF9E9E9E"/>

		<RadioButton
			android:id="@+id/sixmin"
			android:layoutDirection="rtl"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingTop="12dp"
			android:paddingBottom="12dp"
			android:checked="true"
			android:text="After 60 min"
			android:textColor="#E0E0E0"/>

		<View
			android:layout_width="match_parent"
			android:layout_height="1dp"
			android:background="#FF9E9E9E"/>

		<RadioButton
			android:id="@+id/customin"
			android:layoutDirection="rtl"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingTop="12dp"
			android:paddingBottom="12dp"
			android:checked="true"
			android:text="Custom"
			android:textColor="#E0E0E0"/>

	</RadioGroup>

	<android.support.v7.widget.SwitchCompat
		android:id="@+id/switch_animations"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:text="Finish the track"
		android:textColor="#FFFFFF"
		android:padding="12dp"
		app:trackTint="@xml/switch_track_selector"
		app:thumbTint="#FFFFFF"/>

	<TextView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:text="@string/timersubText"
		android:textColor="#808080"
		android:textSize="12sp"
		android:paddingLeft="12dp"
		android:paddingBottom="12dp"/>

	<LinearLayout
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="20dp"
		android:divider="@drawable/vertical_divider"
		android:orientation="horizontal"
		android:showDividers="middle"
		android:gravity="center_horizontal"
		android:weightSum="30">

		<TextView
			android:id="@+id/btn_cancel_timer"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:padding="10dp"
			android:text="CANCEL"
			android:textColor="#FF4040"
			android:textStyle="bold"
			android:clickable="true"
			android:focusable="true"
			android:background="?attr/selectableItemBackground"
			android:layout_gravity="center_vertical"
			android:layout_weight="10"/>

		<View
			android:background="#FF464646"
			android:layout_width="1dp"
			android:layout_height="20dp"
			android:layout_marginLeft="40dp"
			android:layout_marginRight="40dp"
			android:layout_gravity="center_vertical"
			android:layout_weight="10"
			android:id="@+id/customdialogtimerView1"/>

		<TextView
			android:id="@+id/btn_ok"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:padding="10dp"
			android:text="     OK     "
			android:textColor="#FF4040"
			android:textStyle="bold"
			android:clickable="true"
			android:focusable="true"
			android:background="?attr/selectableItemBackground"
			android:layout_gravity="center_vertical"
			android:layout_weight="10"/>

	</LinearLayout>

</LinearLayout>

