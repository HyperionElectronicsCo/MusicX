<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:background="@drawable/dialog_bg"
	android:orientation="vertical"
	android:padding="24dp"
	android:gravity="center_horizontal">

	<TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text="Download quality"
		android:textColor="#FFFFFF"
		android:textSize="20sp"
		android:textStyle="bold"
		android:layout_gravity="left"/>

	<RadioGroup
		android:id="@+id/quality_group"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="16dp">

		<RadioButton
			android:id="@+id/rb_super"
			android:layoutDirection="rtl"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingTop="12dp"
			android:paddingBottom="12dp"
			android:text="Super (SQ)"
			android:textColor="#E0E0E0"/>

		<View
			android:layout_width="match_parent"
			android:layout_height="1dp"
			android:background="#FF9E9E9E"/>

		<RadioButton
			android:id="@+id/rb_high"
			android:layoutDirection="rtl"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingTop="12dp"
			android:paddingBottom="12dp"
			android:text="High (HQ)"
			android:textColor="#E0E0E0"/>

		<View
			android:layout_width="match_parent"
			android:layout_height="1dp"
			android:background="#FF9E9E9E"/>

		<RadioButton
			android:id="@+id/rb_standard"
			android:layoutDirection="rtl"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingTop="12dp"
			android:paddingBottom="12dp"
			android:checked="true"
			android:text="Standard"
			android:textColor="#E0E0E0"/>

	</RadioGroup>

	<TextView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="16dp"
		android:text="@string/downloadqualitySubtext"
		android:textColor="#9E9E9E"
		android:textSize="14sp"/>

	<TextView
		android:id="@+id/btn_cancel"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="center_horizontal"
		android:layout_marginTop="20dp"
		android:clickable="true"
		android:focusable="true"
		android:background="?attr/selectableItemBackground"
		android:text="CANCEL"
		android:textColor="#FF0000"
		android:textStyle="bold"
		android:padding="8dp"/>

</LinearLayout>

