<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/mainbg"
	tools:context="com.hyperion.musicx.ItemOneFragment"
	android:id="@+id/userName">

	<android.support.v7.widget.CardView
		android:layout_width="50dp"
		android:layout_height="50dp"
		android:id="@+id/usercentreTextView1cv"
		app:cardCornerRadius="25dp"
		app:cardElevation="0dp"
		app:cardPreventCornerOverlap="false"
		android:layout_margin="30dp">

		<ImageView
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:id="@+id/usercentreTextView1"
			android:background="@drawable/image_2"
			android:scaleType="centerCrop"/>

	</android.support.v7.widget.CardView>

	<LinearLayout
		android:orientation="horizontal"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:id="@+id/fragmentitemoneLinearLayout1"
		android:layout_toRightOf="@id/usercentreTextView1cv"
		android:layout_marginTop="30dp">

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="Hey, "
			android:textAppearance="?android:attr/textAppearanceMedium"
			android:textColor="#FFFFFFFF"
			android:id="@+id/fragmentitemoneTextView1"
			android:layout_marginLeft="25dp"/>

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textAppearance="?android:attr/textAppearanceMedium"
			android:textColor="#FFFFFDFD"
			android:text="User"/>

	</LinearLayout>

	<LinearLayout
		android:orientation="horizontal"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:id="@+id/fragmentitemoneLinearLayout2"
		android:layout_toRightOf="@id/usercentreTextView1cv"
		android:layout_below="@id/fragmentitemoneLinearLayout1"
		android:layout_marginTop="2dp">

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="welcome back"
			android:textAppearance="?android:attr/textAppearanceMedium"
			android:textColor="#FFFFFFFF"
			android:layout_marginLeft="10dp"/>

	</LinearLayout>

	<LinearLayout
		android:orientation="horizontal"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_below="@id/fragmentitemoneLinearLayout2"
		android:id="@+id/fragmentitemoneLinearLayout3"
		android:gravity="center_horizontal"
		android:layout_marginTop="20dp">

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/mostPlayed"
			android:textAppearance="?android:attr/textAppearanceMedium"
			android:textColor="#FFFFFFFF"
			android:id="@+id/fragmentitemoneTextView1"
			android:gravity="center_horizontal"/>

	</LinearLayout>

	<LinearLayout
		android:orientation="vertical"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_below="@id/fragmentitemoneLinearLayout3"
		android:layout_margin="20dp"
		android:layout_centerInParent="true"
		android:layout_centerVertical="true">

		<ProgressBar
			android:id="@+id/progressBar"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_centerInParent="true"/>

		<ListView
			android:id="@+id/rssListView"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:visibility="gone"/>

	</LinearLayout>

	<ImageButton
		android:id="@+id/settingsTop"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:background="@drawable/circle_button"
		android:src="@drawable/ic_settings"
		android:scaleType="centerInside"
		android:adjustViewBounds="false"
		android:layout_alignParentRight="true"
		android:layout_margin="10dp"/>

</RelativeLayout>

