<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>
	<style name="WhiteText">
		<item name="android:textColor">#FFFFFF</item>
	</style>
	<style name="CustomDialogTheme" parent="android:Theme.Material.Dialog.Alert">
		<!-- Dark grey background like the image -->
		<!--item name="android:colorBackground">#333333</item>-->
		<item name="android:windowBackground">@android:color/transparent</item>
		<item name="android:windowFrame">@null</item>
		<item name="android:windowIsFloating">true</item>
		<!-- This handles the rounded corners -->
		<item name="android:windowBackground">@drawable/dialog_bg</item>
	</style>
	<style name="QualityRadioButton">
		<item name="android:layout_width">match_parent</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="android:paddingTop">12dp</item>
		<item name="android:paddingBottom">12dp</item>
		<item name="android:buttonTint">#FF0000</item>
		<item name="android:textColor">#FFFFFF</item>
		<item name="android:textSize">16sp</item>
		<item name="android:layoutDirection">rtl</item> <!-- Moves button to the right -->
		<item name="android:textAlignment">viewStart</item>
	</style>
	<style name="WhitePicker">
        <item name="android:editTextColor">#FFFFFF</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
    </style>
    <style name="SmallDialogTheme" parent="Theme.AppCompat.Light.Dialog.Alert">
        <!-- Set the background drawable -->
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <!-- Make all text white -->
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColor">#FFFFFF</item>
        <!-- Style the buttons (Yes/No) -->
        <item name="buttonBarPositiveButtonStyle">@style/DialogButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/DialogButtonStyle</item>
        <item name="colorAccent">#FF0000</item>
    </style>
    <style name="DialogButtonStyle" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">#FF0000</item>
    </style>
</resources>
